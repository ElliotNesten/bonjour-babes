{
  "rules": {
    ".read": false,
    ".write": false,

    "setup": {
      ".read": true,
      "adminConfigured": {
        ".write": "auth != null && !data.exists() && newData.parent().parent().child('secret').child('adminHash').exists()",
        ".validate": "newData.val() === true"
      },
      "$other": { ".validate": false }
    },

    "secret": {
      "adminHash": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isString() && newData.val().length === 64"
      },
      "$other": { ".validate": false }
    },

    "adminSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && root.child('secret').child('adminHash').exists() && newData.val() === root.child('secret').child('adminHash').val()"
      }
    },

    "pins": {
      ".read": true,
      "$pin": {
        ".write": "auth != null && root.child('adminSessions').child(auth.uid).exists() && root.child('adminSessions').child(auth.uid).val() === root.child('secret').child('adminHash').val()",
        ".validate": "$pin.matches(/^[0-9]{6}$/) && newData.isString()"
      }
    },

    "hallOfFame": {
      ".read": true,
      "$gameId": {
        ".write": "auth != null && root.child('adminSessions').child(auth.uid).exists() && root.child('adminSessions').child(auth.uid).val() === root.child('secret').child('adminHash').val()"
      }
    },

    "games": {
      ".read": true,
      "$gameId": {
        ".write": "auth != null && root.child('adminSessions').child(auth.uid).exists() && root.child('adminSessions').child(auth.uid).val() === root.child('secret').child('adminHash').val()",

        "players": {
          "$pid": {
            ".write": "auth != null && auth.uid === $pid && root.child('games').child($gameId).child('meta').exists() && (root.child('games').child($gameId).child('meta/status').val() === 'lobby' || root.child('games').child($gameId).child('meta/status').val() === 'running' || data.exists())",
            ".validate": "newData.hasChildren(['name', 'drink', 'emoji', 'color', 'joinedAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
            "drink": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "emoji": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
            "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "manual": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },

        "votes": {
          "$drinkId": {
            "$voterId": {
              ".write": "auth != null && auth.uid === $voterId && $drinkId !== $voterId && root.child('games').child($gameId).child('players').child($voterId).exists() && root.child('games').child($gameId).child('meta/status').val() === 'running' && root.child('games').child($gameId).child('current/drinkId').val() === $drinkId && root.child('games').child($gameId).child('current/phase').val() === 'voting'",
              ".validate": "newData.hasChildren(['taste', 'look', 'creativity', 'again', 'at'])",
              "taste": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10 && newData.val() % 1 === 0" },
              "look": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10 && newData.val() % 1 === 0" },
              "creativity": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10 && newData.val() % 1 === 0" },
              "again": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10 && newData.val() % 1 === 0" },
              "comment": { ".validate": "newData.isString() && newData.val().length <= 280" },
              "at": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        },

        "awardVotes": {
          "$awardId": {
            "$voterId": {
              ".write": "auth != null && auth.uid === $voterId && root.child('games').child($gameId).child('players').child($voterId).exists() && root.child('games').child($gameId).child('meta/status').val() === 'awards'",
              ".validate": "($awardId === 'name' || $awardId === 'daring' || $awardId === 'swamp' || $awardId === 'favorite') && newData.isString() && newData.val() !== $voterId && root.child('games').child($gameId).child('players').child(newData.val()).exists()"
            }
          }
        }
      }
    }
  }
}
