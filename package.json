{
  "name": "bonjour-babes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Bonjour Babes – drinktävling med live-röstning, prisutdelning och Hall of Fame",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode demo",
    "build": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tests",
    "test": "vitest run",
    "test:pg": "vitest run tests/server"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "canvas-confetti": "^1.9.4",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
