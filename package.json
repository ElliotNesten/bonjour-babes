{
  "name": "bonjour-babes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Bonjour Babes – drinktävling med live-röstning, prisutdelning och Hall of Fame",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "dev:local": "vite --mode demo",
    "build": "tsc --noEmit && vite build",
    "build:emu": "tsc --noEmit && vite build --mode emulator --outDir dist-emu",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:rules": "env -u HTTPS_PROXY -u https_proxy -u HTTP_PROXY -u http_proxy firebase emulators:exec --only database,auth --project demo-bonjour \"npx vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --only database,auth --project demo-bonjour"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "firebase": "^13.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
